# ─────────────────────────────────────────────────────────────
# JOLA School — environment variables
# Copy this file to .env and fill in real values.
# Never commit .env or real credentials.
# ─────────────────────────────────────────────────────────────

# MySQL / MariaDB connection (server-side only)
DATABASE_URL="mysql://jola_user:change-me@localhost:3306/jola_school"

# Public site URL (used for canonical URLs, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Institutional contact details ─────────────────────────────
# Leave blank until JOLA confirms the official details. The UI displays
# an honest "to be confirmed" state instead of inventing data.
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_ADMISSIONS_EMAIL=""
NEXT_PUBLIC_CONTACT_ADDRESS_LINE=""
NEXT_PUBLIC_MAP_URL=""

# Official social profiles (full URLs). Leave blank until confirmed.
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""

# ── Optional hero video ───────────────────────────────────────
# Example: /videos/hero.mp4 (place file in public/videos/).
# When empty, the optimized hero still image is used.
NEXT_PUBLIC_HERO_VIDEO_URL=""

# ── Email (Gmail SMTP) ──────────────────────────────────────────
# Usar una "contraseña de aplicación" de Gmail (no la contraseña normal).
# Configurar en: https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
ADMISSIONS_NOTIFY_EMAIL=""

# ── WhatsApp (WhatsApp Cloud API / Meta) ────────────────────────
# Obtener token y phone_number_id en: https://developers.facebook.com/
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TO=""

# ── Initial admin user (used only by `npm run db:seed`) ───────
# Choose a strong password of at least 12 characters.
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional: salt used to hash request IPs. Set a long random value in production.
IP_HASH_SALT="change-me-to-a-long-random-string"
